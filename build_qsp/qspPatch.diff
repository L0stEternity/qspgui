diff --git a/qsp/text.h b/qsp/text.h
index a30ee78..e7e51f7 100644
--- a/qsp/text.h
+++ b/qsp/text.h
@@ -353,6 +353,14 @@
         if (buf->Str) free(buf->Str);
     }
 
+    /* Grow by at least half the current length: a fixed increment makes building
+       a large string (a multi-megabyte save) quadratic in reallocations */
+    INLINE int qspBufStringGrowth(QSPBufString *buf)
+    {
+        int half = buf->Len / 2;
+        return (half > buf->CapacityIncrement ? half : buf->CapacityIncrement);
+    }
+
     INLINE QSP_BOOL qspAddBufText(QSPBufString *dest, QSPString val)
     {
         int valLen = qspStrLen(val);
@@ -362,7 +370,7 @@
             {
                 if (dest->Len + valLen > dest->Capacity)
                 {
-                    dest->Capacity = dest->Len + valLen + dest->CapacityIncrement;
+                    dest->Capacity = dest->Len + valLen + qspBufStringGrowth(dest);
                     dest->Str = (QSP_CHAR *)realloc(dest->Str, dest->Capacity * sizeof(QSP_CHAR));
                 }
                 memcpy(dest->Str + dest->Len, val.Str, valLen * sizeof(QSP_CHAR));
@@ -386,7 +394,7 @@
         {
             if (dest->Len + QSP_CHAR_LEN > dest->Capacity)
             {
-                dest->Capacity = dest->Len + QSP_CHAR_LEN + dest->CapacityIncrement;
+                dest->Capacity = dest->Len + QSP_CHAR_LEN + qspBufStringGrowth(dest);
                 dest->Str = (QSP_CHAR *)realloc(dest->Str, dest->Capacity * sizeof(QSP_CHAR));
