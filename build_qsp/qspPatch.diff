diff --git a/qsp/memory.c b/qsp/memory.c
index d48b88a..4e131db 100644
--- a/qsp/memory.c
+++ b/qsp/memory.c
@@ -9,6 +9,119 @@
 
 QSPMemoryChunk *qspCurAllocChunk = 0;
 
+#ifndef MEMWATCH
+
+/* Size-class pools behind malloc, realloc and free (see declarations.h).
+   Blocks up to QSP_POOLMAXSIZE bytes are cut from 64 KB slabs and kept on a free list
+   per class, larger ones go to the system heap. Each block starts with a header holding
+   its class, so free and realloc know where it came from. Slabs are never returned:
+   the pools only grow to the game's peak. The engine runs on one thread. */
+
+#define QSP_POOLGRANULE 16
+#define QSP_POOLCLASSES 32 /* blocks up to 512 bytes */
+#define QSP_POOLMAXSIZE (QSP_POOLGRANULE * QSP_POOLCLASSES)
+#define QSP_POOLSLABSIZE (64 * 1024)
+#define QSP_POOLLARGE 0xFFFFFFFFu
+
+typedef struct QSPPoolBlock_s
+{
+    struct QSPPoolBlock_s *Next;
+} QSPPoolBlock;
+
+typedef union
+{
+    unsigned int Class;
+    double Align; /* keeps the block after the header aligned for any value */
+} QSPPoolHeader;
+
+static QSPPoolBlock *qspPoolFreeLists[QSP_POOLCLASSES];
+
+static void qspPoolRefill(unsigned int poolClass)
+{
+    size_t blockSize = sizeof(QSPPoolHeader) + (size_t)(poolClass + 1) * QSP_POOLGRANULE;
+    size_t blocksCount = QSP_POOLSLABSIZE / blockSize, i;
+    /* Parentheses keep the macros in declarations.h from turning these into pool calls */
+    unsigned char *slab = (unsigned char *)(malloc)(blocksCount * blockSize);
+    if (!slab) return;
+    for (i = 0; i < blocksCount; ++i)
+    {
+        QSPPoolHeader *header = (QSPPoolHeader *)(slab + i * blockSize);
+        QSPPoolBlock *block = (QSPPoolBlock *)(header + 1);
+        header->Class = poolClass;
+        block->Next = qspPoolFreeLists[poolClass];
+        qspPoolFreeLists[poolClass] = block;
+    }
+}
+
+void *qspPoolAlloc(size_t size)
+{
+    unsigned int poolClass;
+    QSPPoolBlock *block;
+    if (!size) size = 1;
+    if (size > QSP_POOLMAXSIZE)
+    {
+        QSPPoolHeader *header = (QSPPoolHeader *)(malloc)(sizeof(QSPPoolHeader) + size);
+        if (!header) return 0;
+        header->Class = QSP_POOLLARGE;
+        return header + 1;
+    }
+    poolClass = (unsigned int)((size - 1) / QSP_POOLGRANULE);
+    if (!qspPoolFreeLists[poolClass]) qspPoolRefill(poolClass);
+    block = qspPoolFreeLists[poolClass];
+    if (!block) return 0;
+    qspPoolFreeLists[poolClass] = block->Next;
+    return block;
+}
+
+void qspPoolFree(void *ptr)
+{
+    QSPPoolHeader *header;
+    if (!ptr) return;
+    header = (QSPPoolHeader *)ptr - 1;
+    if (header->Class == QSP_POOLLARGE)
+    {
+        (free)(header);
+        return;
+    }
+    ((QSPPoolBlock *)ptr)->Next = qspPoolFreeLists[header->Class];
+    qspPoolFreeLists[header->Class] = (QSPPoolBlock *)ptr;
+}
+
+void *qspPoolRealloc(void *ptr, size_t size)
+{
+    QSPPoolHeader *header;
+    void *newPtr;
+    size_t oldSize;
+    if (!ptr) return qspPoolAlloc(size);
+    if (!size)
+    {
+        qspPoolFree(ptr);
+        return 0;
+    }
+    header = (QSPPoolHeader *)ptr - 1;
+    if (header->Class == QSP_POOLLARGE)
+    {
+        if (size > QSP_POOLMAXSIZE)
+        {
+            QSPPoolHeader *newHeader = (QSPPoolHeader *)(realloc)(header, sizeof(QSPPoolHeader) + size);
+            return (newHeader ? newHeader + 1 : 0);
+        }
+        /* Shrinks into a pool: the new size is the smaller one */
+        newPtr = qspPoolAlloc(size);
+        if (newPtr) memcpy(newPtr, ptr, size);
+        (free)(header);
+        return newPtr;
+    }
+    oldSize = (size_t)(header->Class + 1) * QSP_POOLGRANULE;
+    if (size <= oldSize) return ptr;
+    newPtr = qspPoolAlloc(size);
+    if (newPtr) memcpy(newPtr, ptr, oldSize);
+    qspPoolFree(ptr);
+    return newPtr;
+}
+
+#endif
+
 void qspInitStackAllocator(void)
 {
     qspCurAllocChunk = qspAllocateMemChunk();
