+INLINE unsigned int qspLocNameHash(QSPString name)
+{
+    QSP_CHAR *pos;
+    unsigned int nameHash = 7;
+    for (pos = name.Str; pos < name.End; ++pos)
+        nameHash = nameHash * 31 + (unsigned int)*pos;
+    return nameHash;
+}
+
+INLINE void qspUpdateLocsNamesTable(void)
+{
+    int i;
+    unsigned int size, slot;
+    if (qspLocsNamesTable)
+    {
+        free(qspLocsNamesTable);
+        qspLocsNamesTable = 0;
+    }
+    if (!qspLocsNamesCount) return;
+    for (size = 16; size < (unsigned int)qspLocsNamesCount * 2; size <<= 1);
+    qspLocsNamesTable = (int *)malloc(size * sizeof(int));
+    qspLocsNamesTableMask = size - 1;
+    for (slot = 0; slot < size; ++slot)
+        qspLocsNamesTable[slot] = -1;
+    for (i = 0; i < qspLocsNamesCount; ++i)
+    {
+        /* A duplicate name keeps the entry the binary search used to find */
+        QSPLocName *loc = (QSPLocName *)bsearch(&qspLocsNames[i].Name, qspLocsNames, qspLocsNamesCount, sizeof(QSPLocName), qspLocNameCompare);
+        slot = qspLocNameHash(qspLocsNames[i].Name) & qspLocsNamesTableMask;
+        while (qspLocsNamesTable[slot] >= 0)
+        {
+            if (qspStrsEqual(qspLocsNames[qspLocsNamesTable[slot]].Name, qspLocsNames[i].Name)) break;
+            slot = (slot + 1) & qspLocsNamesTableMask;
+        }
+        qspLocsNamesTable[slot] = (int)(loc - qspLocsNames);
+    }
+}
